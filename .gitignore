# Git ignore template for CLion projects

# IntelliJ IDEA / CLion project files
/.idea/

# CMake build directories (adjust name if you use a custom build folder)
cmake-build-debug/

# CMake generated files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
cmake_install.cmake
Makefile

# Compiled object files, libraries, and executables
*.o
*.obj
*.lo
*.la
*.al
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Static analysis reports
*.plist

# Debug files
*.pdb
*.ilk
*.dSYM/

# Backup and temporary files
*~
*.swp
*.tmp

# Mac OS
.DS_Store

# Windows Thumbnail Cache
Thumbs.db

# User-specific files
*.user
*.user.*
*.suo

# Logs
*.log

# Package files
*.tar.gz
*.zip
*.7z

# Coverage data
coverage/
*.gcno
*.gcda

# Sanitizer reports
*.sanitize

# Ignore build artifacts directories
build/

# Custom: ignore local virtual environments if any
env/
venv/

